# English Self-Assessment — Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml for local production or paste into 
# the Secrets settings in Streamlit Community Cloud.
# NOTE: Never commit .streamlit/secrets.toml into version control!

# Initial Administrator Provisioning (Optional: used for automated container setup)
# ADMIN_INIT_USER = "admin"
# ADMIN_INIT_PASS = "SuperSecurePassword123!"

# Application Settings Override
DEFAULT_QUESTIONS_PER_TEST = 20
